# Stripe keys — get these from https://dashboard.stripe.com/apikeys
# Use your TEST keys (sk_test_ / pk_test_) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Used to build success/cancel redirect URLs. Set to your deployed domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin) — pick your own password and a random secret string.
# Generate a secret with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string

# Auto-filled by Vercel when you attach a Blob store to this project
# (Storage tab → Create Database → Blob). Required for the admin panel to
# save products/photos — without it the site still works, showing the
# built-in seed catalog and hero images read-only.
BLOB_READ_WRITE_TOKEN=

# Supabase — the catalog and orders live here.
# Project settings → API. The service role key bypasses RLS: server-side only,
# never NEXT_PUBLIC_*, never committed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe webhook signing secret. Stripe Dashboard → Developers → Webhooks →
# add endpoint https://your-domain/api/stripe/webhook → copy the signing
# secret. Without it the webhook returns 500 and orders never settle.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Transactional email (order confirmations). RESEND_API_KEY and MAIL_FROM must
# both be set or nothing is sent -- the code logs what it would have sent and
# carries on, so an unconfigured deploy still takes orders.
#
# The root domain is verified in Resend. That is safe alongside Hostinger mail
# because Resend delegates sending through CNAMEs (rsend, send) rather than an
# SPF include, so the root SPF record stays exactly as Hostinger set it.
#
# MAIL_REPLY_TO is optional here -- the From address already reaches the
# Hostinger mailbox. Set it only to route replies somewhere else.
RESEND_API_KEY=
MAIL_FROM="Murrelet <orders@murrelet.co.uk>"
# MAIL_REPLY_TO=
