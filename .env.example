# Stripe keys — get these from https://dashboard.stripe.com/apikeys
# Use your TEST keys (sk_test_ / pk_test_) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Used to build success/cancel redirect URLs. Set to your deployed domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin) — pick your own password and a random secret string.
# Generate a secret with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string

# Files: Cloudflare R2. Two buckets, because a bucket is the unit of public
# access. The public one holds admin uploads and the hero document and is
# served from its public URL; the private one holds shipping labels (customer
# names and addresses) and has NO public URL — those are read only through
# signed URLs that expire. One Account API token, Object Read & Write, scoped
# to both buckets. R2_ACCOUNT_ID is the 32 hex characters in the S3 endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=murrelet
R2_PRIVATE_BUCKET=murrelet-private
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Postgres (Neon) — the catalog and orders live here. Neon dashboard →
# Connect → pooled connection string. Server-side only, never committed.
# Schema: db/0001_schema.sql (how to apply is in its header).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Stripe webhook signing secret. Stripe Dashboard → Developers → Webhooks →
# add endpoint https://your-domain/api/stripe/webhook → copy the signing
# secret. Without it the webhook returns 500 and orders never settle.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Transactional email (order confirmations). RESEND_API_KEY and MAIL_FROM must
# both be set or nothing is sent -- the code logs what it would have sent and
# carries on, so an unconfigured deploy still takes orders.
#
# The root domain is verified in Resend. That is safe alongside Hostinger mail
# because Resend delegates sending through CNAMEs (rsend, send) rather than an
# SPF include, so the root SPF record stays exactly as Hostinger set it.
#
# MAIL_REPLY_TO is optional here -- the From address already reaches the
# Hostinger mailbox. Set it only to route replies somewhere else.
RESEND_API_KEY=
MAIL_FROM="Murrelet <orders@murrelet.co.uk>"
# MAIL_REPLY_TO=

# Shipping labels via Sendcloud (API v3). Without the two keys the admin's
# "Get shipping label" is disabled and nothing else changes. Keys come from
# Sendcloud > Settings > Integrations > Sendcloud API. A sender address must
# exist in the panel (Settings > Addresses); SENDCLOUD_SENDER_ADDRESS_ID pins
# one if there are several. Leave SENDCLOUD_SHIPPING_OPTION_CODE blank to take
# the cheapest contracted home-delivery option per route.
#
# SENDCLOUD_TEST_MODE=true buys only the free "unstamped letter" -- a real
# parcel record with a real label and no carrier invoice. Use it for the first
# end-to-end run.
#
# The webhook (Settings > Integrations > Webhooks, event parcel_status_changed)
# is https://murrelet.co.uk/api/sendcloud/webhook?secret=<SENDCLOUD_WEBHOOK_SECRET>
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_WEBHOOK_SECRET=
SENDCLOUD_SENDER_ADDRESS_ID=
SENDCLOUD_SHIPPING_OPTION_CODE=
SENDCLOUD_TEST_MODE=true
