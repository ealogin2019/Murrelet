// Cloudflare Workers deployment for murrelet.co.uk (replacing Vercel).
//
// nodejs_compat is required: the app uses node:crypto (createHash for the
// catalogue version, createHmac/timingSafeEqual in the Sendcloud webhook) and
// Buffer. Secrets are NOT in this file -- they are set with
// `npx wrangler secret put NAME` by the owner, one per variable, matching the
// names in .env.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murrelet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The live domain. Custom domains make Cloudflare create and own the DNS
  // records and certificates for these names, so any existing A/CNAME for
  // them (the old Vercel ones) must be deleted from the zone first or the
  // deploy refuses. www is served too, and middleware.ts redirects it to the
  // bare domain so there is one canonical address.
  "routes": [
    { "pattern": "murrelet.co.uk", "custom_domain": true },
    { "pattern": "www.murrelet.co.uk", "custom_domain": true }
  ]
}
